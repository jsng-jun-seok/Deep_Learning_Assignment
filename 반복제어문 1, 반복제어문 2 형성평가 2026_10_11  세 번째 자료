import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int sum = 0;   // 합계
        int count = 0; // 입력된 유효한 정수의 개수
        
        while (sc.hasNextInt()) {
            int num = sc.nextInt();
            
            // 0 이상 100 이하를 벗어나면 반복 종료
            if (num < 0 || num > 100) {
                break;
            }
            
            sum += num;
            count++;
        }
        
        // 평균 계산 (소수점 이하 값을 구하기 위해 double 타입으로 형변환)
        double avg = (double) sum / count;
        
        System.out.println("sum : " + sum);
        System.out.printf("avg : %.1f\n", avg);
    }
}


