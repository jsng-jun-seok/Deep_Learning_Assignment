import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int oddCount = 0;  // 홀수 개수
        int evenCount = 0; // 짝수 개수
        
        while (sc.hasNextInt()) {
            int num = sc.nextInt();
            
            // 0이 입력되면 반복 종료
            if (num == 0) {
                break;
            }
            
            // 홀수/짝수 판별
            if (num % 2 != 0) {
                oddCount++;
            } else {
                evenCount++;
            }
        }
        
        System.out.println("odd : " + oddCount);
        System.out.println("even : " + evenCount);
    }
}


