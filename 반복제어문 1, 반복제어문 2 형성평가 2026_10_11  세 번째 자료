import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int s = sc.nextInt(); // 시작 단
        int e = sc.nextInt(); // 끝 단
        
        // 1부터 9까지 곱하는 수 반복 (행 단위 출력)
        for (int i = 1; i <= 9; i++) {
            
            // s가 e보다 큰 경우 (예: 5 3 -> 5, 4, 3단)
            if (s >= e) {
                for (int dan = s; dan >= e; dan--) {
                    System.out.printf("%d * %d = %2d", dan, i, dan * i);
                    if (dan > e) {
                        System.out.print("   "); // 구구단 사이 공백 3칸
                    }
                }
            } 
            // s가 e보다 작은 경우 (예: 3 5 -> 3, 4, 5단)
            else {
                for (int dan = s; dan <= e; dan++) {
                    System.out.printf("%d * %d = %2d", dan, i, dan * i);
                    if (dan < e) {
                        System.out.print("   "); // 구구단 사이 공백 3칸
                    }
                }
            }
            
            // 한 행 출력이 끝나면 줄바꿈
            System.out.println();
        }
    }
}


