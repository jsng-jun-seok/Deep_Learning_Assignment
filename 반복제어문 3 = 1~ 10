import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();

        // 1. 상단부 (역삼각형)
        for (int i = 0; i < n; i++) {
            // 공백
            for (int j = 0; j < i; j++) {
                System.out.print(" ");
            }
            // 별
            for (int j = 0; j < 2 * (n - i) - 1; j++) {
                System.out.print("*");
            }
            System.out.println();
        }

        // 2. 하단부 (정삼각형)
        for (int i = n - 2; i >= 0; i--) {
            // 공백
            for (int j = 0; j < i; j++) {
                System.out.print(" ");
            }
            // 별
            for (int j = 0; j < 2 * (n - i) - 1; j++) {
                System.out.print("*");
            }
            System.out.println();
        }

        scanner.close();
    }
}


