import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();

        int num = 1;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(num + " ");
                
                // 다음 홀수로 증가
                num += 2;
                
                // 10 이상이 되면 다시 1로 순환
                if (num > 9) {
                    num = 1;
                }
            }
            System.out.println();
        }

        scanner.close();
    }
}
