import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();

        char ch = 'A';
        int num = 0;

        for (int i = 1; i <= n; i++) {
            // 문자는 (n - i + 1)개 출력
            for (int j = 0; j < n - i + 1; j++) {
                System.out.print(ch++ + " ");
            }

            // 숫자는 (i - 1)개 출력
            for (int j = 0; j < i - 1; j++) {
                System.out.print(num++ + " ");
            }

            System.out.println();
        }

        scanner.close();
    }
}


