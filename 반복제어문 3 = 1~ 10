import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();

        for (int i = 1; ; i++) {
            int multiple = n * i;

            // 100보다 작은 배수만 출력 (100 이상이면 종료)
            if (multiple >= 100) {
                break;
            }

            System.out.print(multiple + " ");

            // 출력한 배수가 10의 배수이면 종료
            if (multiple % 10 == 0) {
                break;
            }
        }

        scanner.close();
    }
}


