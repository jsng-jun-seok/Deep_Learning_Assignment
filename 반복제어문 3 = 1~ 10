// 형성평가 1

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        int sum = 0;
        int count = 0;

        for (int i = 0; i < 20; i++) {
            int num = scanner.nextInt();

            // 0이 입력되면 즉시 반복 종료
            if (num == 0) {
                break;
            }

            sum += num;
            count++;
        }

        // 입력된 숫자가 있는 경우 합과 정수 평균 출력
        if (count > 0) {
            System.out.println(sum + " " + (sum / count));
        } else {
            System.out.println("0 0");
        }

        scanner.close();
    }
}


