#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // 1. 상단부 (1 ~ n줄): #을 1개부터 n개까지 출력
    for (int i = 1; i <= n; i++) {
        for (int j = 0; j < i; j++) {
            printf("# ");
        }
        printf("\n");
    }

    // 2. 하단부 (n-1줄): 공백을 늘해가며 #을 n-1개부터 1개까지 출력
    for (int i = 1; i <= n - 1; i++) {
        // 공백 출력: i * 2개
        for (int j = 0; j < i * 2; j++) {
            printf(" ");
        }
        // # 출력: (n - i)개
        for (int j = 0; j < n - i; j++) {
            printf("# ");
        }
        printf("\n");
    }

    return 0;
}


