import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int[][] arr = new int[4][2];
        int totalSum = 0; // 전체 합계를 저장할 변수

        // 1. 4행 2열 데이터 입력받기
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 2; j++) {
                arr[i][j] = scanner.nextInt();
                totalSum += arr[i][j]; // 전체 합계 누적
            }
        }

        // 2. 가로(행) 평균 출력
        for (int i = 0; i < 4; i++) {
            int rowSum = arr[i][0] + arr[i][1];
            System.out.print((rowSum / 2) + " "); // 각 행의 요소 2개 평균
        }
        System.out.println();

        // 3. 세로(열) 평균 출력
        for (int j = 0; j < 2; j++) {
            int colSum = 0;
            for (int i = 0; i < 4; i++) {
                colSum += arr[i][j];
            }
            System.out.print((colSum / 4) + " "); // 각 열의 요소 4개 평균
        }
        System.out.println();

        // 4. 전체 평균 출력 (총 8개 요소)
        System.out.println(totalSum / 8);

        scanner.close();
    }
}


