import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int[] arr = new int[10];      // 10개 숫자를 저장할 배열 생성
        arr[0] = scanner.nextInt();   // 첫 번째 항 입력
        arr[1] = scanner.nextInt();   // 두 번째 항 입력

        // 3번째 항(인덱스 2)부터 10번째 항(인덱스 9)까지 규칙 적용
        for (int i = 2; i < 10; i++) {
            // (전전항 + 전항)의 합에서 1의 자리를 얻기 위해 % 10 연산 수행
            arr[i] = (arr[i - 2] + arr[i - 1]) % 10;
        }

        // 결과 10개 출력
        for (int i = 0; i < 10; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();

        scanner.close();
    }
}


