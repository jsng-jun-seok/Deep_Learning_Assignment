// 형성평가 6

public class Main {
    public static void main(String[] args) {
        // 5행 5열 2차원 배열 선언
        int[][] arr = new int[5][5];

        // 1행(인덱스 0)의 1열(0), 3열(2), 5열(4)을 1로 초기화 (나머지는 자동으로 0)
        arr[0][0] = 1;
        arr[0][2] = 1;
        arr[0][4] = 1;

        // 2행(인덱스 1)부터 5행(인덱스 4)까지 값 채우기
        for (int i = 1; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                int left = 0;
                int right = 0;

                // 바로 위 행의 왼쪽(j - 1) 값이 존재하면 가져옴
                if (j - 1 >= 0) {
                    left = arr[i - 1][j - 1];
                }

                // 바로 위 행의 오른쪽(j + 1) 값이 존재하면 가져옴
                if (j + 1 < 5) {
                    right = arr[i - 1][j + 1];
                }

                // 바로 위행의 왼쪽과 오른쪽 값을 더함
                arr[i][j] = left + right;
            }
        }

        // 완성된 5x5 배열 출력
        for (int i = 0; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                System.out.print(arr[i][j] + " ");
            }
            System.out.println();
        }
    }
}


