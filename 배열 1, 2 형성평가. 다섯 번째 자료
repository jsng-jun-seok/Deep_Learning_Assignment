import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int[][] arr1 = new int[2][3]; // 첫 번째 2행 3열 배열
        int[][] arr2 = new int[2][3]; // 두 번째 2행 3열 배열
        int[][] result = new int[2][3]; // 같은 위치의 값을 곱해 저장할 배열

        // 1. 첫 번째 배열 입력 받기
        System.out.println("first array");
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 3; j++) {
                arr1[i][j] = scanner.nextInt();
            }
        }

        // 2. 두 번째 배열 입력 받기
        System.out.println("second array");
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 3; j++) {
                arr2[i][j] = scanner.nextInt();
            }
        }

        // 3. 같은 위치 요소끼리 곱하여 새로운 배열에 저장 및 출력
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 3; j++) {
                result[i][j] = arr1[i][j] * arr2[i][j]; // 동일한 인덱스끼리 곱 연산
                System.out.print(result[i][j] + " ");
            }
            System.out.println(); // 한 행이 끝나면 줄바꿈
        }

        scanner.close();
    }
}


