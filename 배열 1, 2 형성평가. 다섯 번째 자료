            if (arr[i] % 2 != 0) {
                // 홀수: 2배
                System.out.print((arr[i] * 2) + " ");
            } else {
                // 짝수: 2로 나눈 몫
                System.out.print((arr[i] / 2) + " ");
            }
        }
        System.out.println();

        scanner.close();
    }
}


